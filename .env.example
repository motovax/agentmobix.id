# Mobix Developer API public key. This is intentionally shipped to browser JS.
VITE_MOBIX_API_KEY=
VITE_MOBIX_API_BASE=https://mobix.motovax.com
VITE_MOBIX_IMAGE_BASE=https://mobix.motovax.com
VITE_MOTOVAX_AUTH_API_BASE=https://mobix.motovax.com
# Salah satu token harus ada pada navigator.userAgent agar portal login aktif.
VITE_AGENT_USER_AGENT_TOKENS=AgenMobix,AgentMobix

# Strapi CMS public/browser key.
VITE_STRAPI_API_KEY=
VITE_CMS_API_BASE=https://api.mobixbydss.id/api
VITE_CMS_IMAGE_BASE=https://api.mobixbydss.id

# Falcon live runtime used by the AI Mobix chat.
VITE_FALCON_API_BASE=https://motovax-ai.motovax.com
VITE_FALCON_DEMO_SLUG=motovax-ai
